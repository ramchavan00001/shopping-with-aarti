# Public base URL for reel videos and posters (Cloudflare R2 public bucket or
# custom domain), e.g. https://media.shopwithaarti.in
# Catalogue entries with relative paths like "reels/a101.mp4" are resolved
# against it; absolute URLs are used as-is.
MEDIA_BASE_URL=

# Optional: brand enquiries from the About page are POSTed here as JSON
# (Google Apps Script web app, Zapier/Make webhook, etc.). Without it they are
# only written to the server logs.
ENQUIRY_WEBHOOK_URL=

# Port for the Node server (Render sets this automatically).
PORT=3000
