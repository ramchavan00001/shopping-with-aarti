# Copy to .env for local development (`npm run dev` and `npm start` read it).

# PostgreSQL connection string. Without it the site runs read-only on the
# demo catalogue in shared/catalog.ts and the admin panel can't save.
DATABASE_URL=postgres://aarti:aarti@localhost:5432/aarti

# Password for /admin, and the key that signs admin login cookies.
ADMIN_PASSWORD=change-me
SESSION_SECRET=any-long-random-string

# Fill an empty database with the demo catalogue on first start ("false" to skip).
SEED_DEMO=true

# Public base URL for media, e.g. https://media.shopwithaarti.in (an R2
# bucket's public URL or custom domain). Relative paths like
# "reels/a101.mp4" are resolved against it.
MEDIA_BASE_URL=

# Cloudflare R2 credentials for uploads from the admin panel (all optional;
# without them, paste media URLs instead).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: brand enquiries are also POSTed here as JSON.
ENQUIRY_WEBHOOK_URL=

# Port for the Node server (Render sets this automatically).
PORT=3000

# Phase 2 (all optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=
# GOOGLE_SITE_VERIFICATION=
# SITE_URL=https://shopping-with-aarti.onrender.com
# CRON_SECRET=
