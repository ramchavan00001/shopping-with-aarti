// Cloudflare Workers config (optional preview target). Static files in ./dist
// are served by Workers Static Assets; only the run_worker_first paths reach
// the Worker code. The Worker serves the demo catalogue read-only: the
// database and /admin run on the Node deployment (Render).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopping-with-aarti",
  "main": "server/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/go/*", "/look/*", "/sitemap.xml"]
  },
  "vars": {
    // Public base URL of the R2 bucket (or custom domain) holding reel videos
    // and posters. Leave empty while the catalogue uses absolute demo URLs.
    "MEDIA_BASE_URL": ""
    // ENQUIRY_WEBHOOK_URL is a secret: `npx wrangler secret put ENQUIRY_WEBHOOK_URL`
  },
  "observability": {
    "enabled": true
  }
}
